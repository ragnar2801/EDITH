# Copy to .env to override defaults. All settings are optional.
# FRIDAY_PORT=8000
# FRIDAY_DATA_DIR=C:\Users\me\Friday\data
# FRIDAY_LOG_DIR=C:\Users\me\Friday\logs
# SEC asks for a name and contact email; set it to also fetch US company ids (CIKs).
# FRIDAY_SEC_USER_AGENT=Your Name you@example.com
# Receive pushes from the FM app on your phone (Sync to PC: this PC's address, port 8090).
# FRIDAY_FM_PUSH=true
# FRIDAY_FM_PUSH_PORT=8090
# Blank token: one is made in data\fm\token.txt.
# FRIDAY_FM_PUSH_TOKEN=
# Also hand each copy to FM's desktop app, which picks it up when it next starts:
# FRIDAY_FM_FORWARD_DIR=C:\Users\me\Documents
# FM accounts to leave out, comma-separated:
# FRIDAY_FM_SKIP_ACCOUNTS=Amma IndMoney
