# Keep LF line endings on every OS (Windows checkouts included), so formatters and
# generated-file checks behave the same everywhere.
* text=auto eol=lf
*.png binary
*.jpg binary
*.ico binary

# Source-list fixtures are byte-for-byte slices of real downloads (CRLF and all).
backend/tests/fixtures/instruments/** -text
backend/tests/fixtures/navs/** -text
